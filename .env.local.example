# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string (M0 free tier cluster).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/url-shortener?retryWrites=true&w=majority
MONGODB_URI=

# Shared secret required in the x-outbox-secret header to call POST /api/process-outbox.
# Generate one with: openssl rand -hex 32
# Must also be set as a GitHub Actions secret (OUTBOX_SECRET) and in Vercel's env vars.
OUTBOX_SECRET=

# development | production | test — Next.js sets this automatically at build/runtime,
# but it's included here so the env schema documents every variable it validates.
NODE_ENV=development
