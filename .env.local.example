# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas connection string (M0 free tier cluster).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/url-shortener?retryWrites=true&w=majority
MONGODB_URI=

# Shared secret required in the x-outbox-secret header to call POST /api/process-outbox.
# Generate one with: openssl rand -hex 32
# Must also be set as a GitHub Actions secret (OUTBOX_SECRET) and in Vercel's env vars.
OUTBOX_SECRET=

# NextAuth session signing secret. Generate one with: openssl rand -base64 32
# A different value for local dev vs. production is fine (and preferable).
AUTH_SECRET=

# GitHub OAuth App credentials (Settings -> Developer settings -> OAuth Apps).
# You need TWO separate OAuth Apps, since each supports only one callback URL:
#   - Dev app:  Homepage http://localhost:3000
#               Callback http://localhost:3000/api/auth/callback/github
#   - Prod app: Homepage <your Vercel URL>
#               Callback <your Vercel URL>/api/auth/callback/github
# Use the dev app's values here; use the prod app's values in Vercel's env vars.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client credentials (Google Cloud Console -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID, type "Web application").
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# development | production | test — Next.js sets this automatically at build/runtime,
# but it's included here so the env schema documents every variable it validates.
NODE_ENV=development
